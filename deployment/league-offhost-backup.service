[Unit]
Description=Verified private off-host backup of League paper snapshots
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStartPre=/usr/bin/docker exec --user 10001 league-engine-1 python -c "from pathlib import Path; from operations import BackupManager; BackupManager(Path('/state/paper/intraday_500k.sqlite3'),Path('/state/paper/backups')).run_once()"
ExecStart=/usr/bin/docker exec --user 10001 league-engine-1 python /app/offhost_backup.py --account leaguebackupdedf75 --state /state/paper
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
